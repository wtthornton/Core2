# Copy to .env for local secrets. Never commit .env.

# Optional: Linear API key for non-OAuth automation (Ralph / scripts).
# Interactive Cursor uses Linear MCP OAuth instead.
# LINEAR_API_KEY=

# TappsMCP brain (optional until tapps-mcp init is run)
# TAPPS_MCP_MEMORY_BRAIN_HTTP_URL=http://localhost:8080
# TAPPS_BRAIN_AUTH_TOKEN=
